// ============================================================
// Prisma Schema — Plateforme de gestion de recettes
// Stack : NestJS + PostgreSQL + Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum MealSlot {
  MIDI
  SOIR
}

enum Unit {
  G
  KG
  ML
  CL
  L
  PIECE
  CUILLERE_A_SOUPE
  CUILLERE_A_CAFE
  TASSE
  PINCEE
}

// ============================================================
// USER
// ============================================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  pseudo        String   @unique
  passwordHash  String   @map("password_hash")
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  recipes         Recipe[]
  ingredients     Ingredient[]
  calendarEntries CalendarEntry[]
  stocks          Stock[]
  shoppingLists   ShoppingList[]

  @@map("users")
}

// ============================================================
// RECIPE
// ============================================================

model Recipe {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  description String?
  prepTimeMin Int?     @map("prep_time_min")
  cookTimeMin Int?     @map("cook_time_min")
  servings    Int      @default(2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeIngredients     RecipeIngredient[]
  steps                 RecipeStep[]
  calendarEntries       CalendarEntry[]    @relation("PlannedRecipe")
  actualCalendarEntries CalendarEntry[]    @relation("ActualRecipe")

  @@map("recipes")
}

// ============================================================
// INGREDIENT (table pivot centrale)
// ============================================================

model Ingredient {
  id          String @id @default(uuid())
  userId      String @map("user_id")
  name        String
  defaultUnit Unit   @map("default_unit")
  // Poids d'une cuillère à soupe (15 ml) en grammes : permet de passer du poids
  // au volume pour cet ingrédient (farine ≈ 10 g). Absent = conversion refusée.
  gramsPerTablespoon Float? @map("grams_per_tablespoon")

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeIngredients RecipeIngredient[]
  stocks            Stock[]
  shoppingItems     ShoppingItem[]
  calendarConsumptions CalendarEntryConsumption[]

  // Un utilisateur ne peut pas avoir deux ingrédients avec le même nom
  @@unique([userId, name])
  @@map("ingredients")
}

// ============================================================
// RECIPE_INGREDIENT (table de liaison recette <-> ingrédient)
// ============================================================

model RecipeIngredient {
  id           String @id @default(uuid())
  recipeId     String @map("recipe_id")
  ingredientId String @map("ingredient_id")
  quantity     Float
  unit         Unit

  // Relations
  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

// ============================================================
// RECIPE_STEP
// ============================================================

model RecipeStep {
  id          String @id @default(uuid())
  recipeId    String @map("recipe_id")
  stepOrder   Int    @map("step_order")
  instruction String

  // Relations
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, stepOrder])
  @@map("recipe_steps")
}

// ============================================================
// CALENDAR_ENTRY
// Deux FK vers Recipe : recette prévue vs recette réellement faite
// ============================================================

model CalendarEntry {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  recipeId       String    @map("recipe_id")
  plannedDate    DateTime  @map("planned_date") @db.Date
  mealSlot       MealSlot  @map("meal_slot")
  // Nombre de portions confirmé au moment de la planification (par défaut
  // celui de la recette, mais ajustable par repas). Sert à mettre à
  // l'echelle les quantités d'ingrédients pour ce repas précis.
  servings       Int       @default(1)
  done           Boolean   @default(false)
  actualRecipeId String?   @map("actual_recipe_id") // null si repas non validé
  validatedAt    DateTime? @map("validated_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relations
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe       Recipe  @relation("PlannedRecipe", fields: [recipeId], references: [id], onDelete: Restrict)
  actualRecipe Recipe? @relation("ActualRecipe", fields: [actualRecipeId], references: [id], onDelete: SetNull)
  consumptions CalendarEntryConsumption[]

  // Un utilisateur ne peut avoir qu'une recette par créneau par jour
  @@unique([userId, plannedDate, mealSlot])
  @@map("calendar_entries")
}

// ============================================================
// CALENDAR_ENTRY_CONSUMPTION
// Quantité réellement retirée du stock quand un repas est validé.
// Nécessaire pour pouvoir remettre exactement cette quantité au stock
// si le repas est dévalidé (le stock peut avoir changé entre-temps).
// ============================================================

model CalendarEntryConsumption {
  id              String @id @default(uuid())
  calendarEntryId String @map("calendar_entry_id")
  ingredientId    String @map("ingredient_id")
  quantity        Float
  unit            Unit

  // Relations
  calendarEntry CalendarEntry @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([calendarEntryId, ingredientId])
  @@map("calendar_entry_consumptions")
}

// ============================================================
// STOCK
// ============================================================

model Stock {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  ingredientId String    @map("ingredient_id")
  quantity     Float
  unit         Unit
  expiresAt    DateTime? @map("expires_at") @db.Date
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  // Un seul enregistrement de stock par ingrédient par utilisateur
  @@unique([userId, ingredientId])
  @@map("stock")
}

// ============================================================
// SHOPPING_LIST
// ============================================================

model ShoppingList {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  validated   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ShoppingItem[]

  // Empêche deux listes du même utilisateur de couvrir un jour en commun
  // (validerait deux fois le même besoin et doublerait le stock). Contrainte
  // d'exclusion GiST plutôt qu'un simple @@unique : la plage est libre, pas
  // alignée sur une semaine fixe. Ajoutée à la main dans la migration SQL,
  // Prisma ne modélise pas les contraintes EXCLUDE.
  @@map("shopping_lists")
}

// ============================================================
// SHOPPING_ITEM
// quantityNeeded  = total requis par les recettes de la semaine
// quantityInStock = snapshot du stock au moment de la génération
// => quantité à acheter = max(0, quantityNeeded - quantityInStock)
// ============================================================

model ShoppingItem {
  id                 String  @id @default(uuid())
  listId             String  @map("list_id")
  ingredientId       String  @map("ingredient_id")
  quantityNeeded     Float   @map("quantity_needed")
  quantityInStock    Float   @default(0) @map("quantity_in_stock")
  unit               Unit
  checked            Boolean @default(false)
  // Quantité réellement ajoutée au stock lors de la validation de la liste.
  // Permet de "dévalider" la liste en retirant exactement ce qui a été ajouté,
  // même si le stock a changé depuis (ex: consommation via le calendrier).
  purchasedQuantity  Float   @default(0) @map("purchased_quantity")

  // Relations
  list       ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  ingredient Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([listId, ingredientId])
  @@map("shopping_items")
}
